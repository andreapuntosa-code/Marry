        {
          "type": "drawing",
          "drawing": "IntegralSign",
          "at": "write",
          "duration": 1.0,
          "x": 250,
          "y": 620,
          "width": 200,
          "height": 470
        },
        {
          "type": "text",
          "text": "f(x)",
          "at": "f",
          "x": 580,
          "y": 630,
          "size": 170,
          "cps": 8
        },
        {
          "type": "text",
          "text": "dx",
          "at": "d",
          "x": 880,
          "y": 630,
          "size": 170,
          "cps": 6
        },
        {
          "type": "text",
          "text": "b",
          "at": "b",
          "x": 345,
          "y": 360,
          "size": 100,
          "color": "blue"
        },
        {
          "type": "text",
          "text": "a",
          "at": "a",
          "x": 245,
          "y": 905,
          "size": 100,
          "color": "blue"
        },
        {
          "type": "text",
