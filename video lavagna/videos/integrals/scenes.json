          "at": "tiny",
          "x": 880,
          "y": 1150,
          "size": 80
        },
        {
          "type": "text",
          "text": "= area under f(x)\nfrom *a* to *b*",
          "at": "start",
          "x": 540,
          "y": 1400,
          "size": 96,
          "cps": 28
        }
      ]
    },
    {
      "id": "example",
      "narration": "Let's try a real one: the area under the line y equals x, from zero to two. The integral gives us... two. Can we check it? Sure! The shape is just a triangle. Half of base times height: one half, times two, times two... equals two. It works!",
      "actions": [
        {
          "type": "drawing",
          "drawing": "LineGraph",
          "at": "line",
          "duration": 1.6,
          "cues": [
            "zero",
            "triangle"
          ],
          "cueDuration": 1.2,
          "x": 540,
          "y": 560,
          "width": 720,
          "height": 700
        },
        {
          "type": "drawing",
          "drawing": "IntegralSign",
          "at": "area",
          "duration": 0.7,
          "x": 300,
          "y": 1080,
          "width": 90,
          "height": 210
        },
        {
          "type": "text",
          "text": "2",
          "at": "zero",
          "delay": 0.5,
          "x": 362,
          "y": 985,
          "size": 56
        },
        {
          "type": "text",
