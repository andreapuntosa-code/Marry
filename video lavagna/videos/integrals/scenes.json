          "y": 362,
          "size": 74,
          "color": "blue"
        },
        {
          "type": "text",
          "text": "← start",
          "at": "start",
          "x": 390,
          "y": 907,
          "size": 74,
          "color": "blue"
        },
        {
          "type": "drawing",
          "drawing": "Arrow",
          "props": {
            "direction": "up"
          },
          "at": "sum",
          "duration": 0.4,
          "x": 140,
          "y": 990,
          "width": 60,
          "height": 200,
          "color": "yellow"
        },
        {
          "type": "text",
          "text": "*sum*",
          "at": "sum",
          "x": 140,
          "y": 1150,
          "size": 90
        },
        {
          "type": "drawing",
          "drawing": "Arrow",
          "props": {
            "direction": "up"
          },
          "at": "height",
          "duration": 0.5,
          "x": 580,
          "y": 930,
          "width": 60,
          "height": 320,
          "color": "yellow"
        },
        {
          "type": "text",
