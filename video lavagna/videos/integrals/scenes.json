          "at": "height",
          "x": 560,
          "y": 1150,
          "size": 90
        },
        {
          "type": "drawing",
          "drawing": "Arrow",
          "props": {
            "direction": "up"
          },
          "at": "tiny",
          "duration": 0.5,
          "x": 880,
          "y": 930,
          "width": 60,
          "height": 320,
          "color": "yellow"
        },
        {
          "type": "text",
