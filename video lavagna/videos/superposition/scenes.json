          "at": "light",
          "delay": 0.4,
          "x": 610,
          "y": 1490,
          "size": 70,
          "cps": 24
        }
      ]
    },
    {
      "id": "outro",
      "narration": "This is how quantum computers work: their qubits are like spinning tops that are zero and one at the same time. In the next video: entanglement, or twin spinning tops.",
